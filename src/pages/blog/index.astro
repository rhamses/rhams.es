---
import BaseLayout from "../../layouts/BlogBase.astro";
import { getCollection } from "astro:content";
import slugify from "../../utils/slugify";
let posts = await getCollection("blog");
const title = "Rhamsés Blog";
const description = "Articles about software engineering and Web development.";
const permalink = `/`;
posts = posts.sort(
  (a, b) =>
    new Date(b.data.publishDate).valueOf() -
    new Date(a.data.publishDate).valueOf()
);
const toIsoDate = (value: string) => {
  const parsed = new Date(value);
  return isNaN(parsed.getTime()) ? value : parsed.toISOString();
};
const origin = Astro.url.origin;
const canonicalUrl = Astro.url.href;
const publisher = {
  "@type": "Organization",
  name: "Rhamsés",
  logo: {
    "@type": "ImageObject",
    url: new URL("/favicon/android-icon-192x192.png", origin).href,
  },
};
const author = { "@type": "Person", name: "Rhamsés" };
const blogPosts = posts.map((post) => {
  const postUrl = new URL(`/blog/${post.id}`, origin).href;
  const imageUrl = new URL(
    `/assets/blog/${slugify(post.data.title)}/capa.webp`,
    origin
  ).href;
  const isoPublishDate = toIsoDate(post.data.publishDate);
  return {
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    url: postUrl,
    image: imageUrl,
    datePublished: isoPublishDate,
    dateModified: isoPublishDate,
    author,
  };
});
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: title,
    description,
    url: canonicalUrl,
    publisher,
    inLanguage: "pt-BR",
    blogPost: blogPosts,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `${title} posts`,
    itemListOrder: "Descending",
    itemListElement: blogPosts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: post.url,
      name: post.headline,
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  current="blog"
>
  <div class="container">
    <h1>Latest Articles</h1>
    {
      posts.map((post, index) => {
        const href = `/${post.id}`;
        return (
          <div>
            {index !== 0 && <hr />}
            <div class="post-item">
              <figure>
                <a href={"blog" + href}>
                  <img
                    src={
                      "/assets/blog/" + slugify(post.data.title) + "/capa.webp"
                    }
                    alt=""
                  />
                </a>
              </figure>
              <h2>
                <a href={"blog" + href}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              <div class="post-item-footer">
                <span class="post-item-date">— {post.data.publishDate}</span>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
  <script type="application/ld+json">
    {JSON.stringify(structuredData)}
  </script>
</BaseLayout>

<style>
  h2,
  .post-item-footer {
    font-family: var(--font-family-sans);
    font-weight: 700;
  }

  .post-item-date {
    color: var(--text-secondary);
    text-align: left;
    text-transform: uppercase;
    margin-right: 16px;
  }

  hr {
    margin: 60px auto;
  }
</style>
