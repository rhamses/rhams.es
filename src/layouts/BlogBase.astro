---
import BaseHead from "../components/blog/BaseHead.astro";
import Header from "../components/blog/Header.astro";
import Footer from "../components/blog/Footer.astro";

export interface Props {
  title: string;
  description: string;
  permalink: string;
  current?: string;
  image?: string;
}
const { title, description, permalink, current, image } = Astro.props;
---

<html lang="pt-br">
  <head>
    <BaseHead
      title={title}
      description={description}
      permalink={permalink}
      image={image}
    />
  </head>
  <body>
    <div class="layout">
      <Header current={current} />

      <main>
        <slot />
      </main>

      <Footer />
    </div>
    <style>
      .layout {
        display: flex;
        flex-direction: column;
        min-height: 100%;
        min-height: 100vh;
      }

      main {
        flex: 1;
        position: relative;
        margin: 0 auto;
        max-width: 1400px;
        padding: 1em 2em;
        box-sizing: border-box;
        width: 100%;
        display: flex;
        flex-direction: column;
      }
    </style>
  </body>
</html>
