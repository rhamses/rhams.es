---
// Top progress bar. Runs while this page loads and from a link click or form
// submit until the next page replaces it. Inline so it starts before the
// bundled scripts.
---

<div class="page-loader" aria-hidden="true"><div class="page-loader__bar"></div></div>
<script is:inline>
	(() => {
		const root = document.currentScript.previousElementSibling;
		const bar = root.firstElementChild;
		let progress = 0;
		let timer = 0;

		const set = (value) => {
			progress = value;
			bar.style.transform = `scaleX(${value})`;
		};

		// Eases towards 90% so the bar never looks finished before it is.
		const start = (from) => {
			clearInterval(timer);
			root.classList.remove("is-done");
			root.classList.add("is-active");
			set(Math.max(progress, from));
			timer = setInterval(() => set(progress + (0.9 - progress) * 0.1), 250);
		};

		const finish = () => {
			clearInterval(timer);
			set(1);
			root.classList.add("is-done");
			setTimeout(() => {
				root.classList.remove("is-active", "is-done");
				set(0);
			}, 400);
		};

		if (document.readyState !== "complete") {
			start(0.2);
			addEventListener("load", finish, { once: true });
		}

		document.addEventListener("click", (event) => {
			if (event.defaultPrevented || event.button !== 0) return;
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
			if (!link || link.hasAttribute("download")) return;
			if (link.target && link.target !== "_self") return;
			const url = new URL(link.href, location.href);
			if (url.origin !== location.origin) return;
			const samePage = url.pathname === location.pathname && url.search === location.search;
			if (samePage && url.hash) return;
			start(0.1);
		});

		document.addEventListener("submit", (event) => {
			if (!event.defaultPrevented) start(0.1);
		});

		// Back/forward cache restores the page as it was left, bar included.
		addEventListener("pageshow", (event) => {
			if (event.persisted) finish();
		});
	})();
</script>

<style>
	.page-loader {
		position: fixed;
		inset: env(safe-area-inset-top) 0 auto;
		z-index: 2000;
		height: 3px;
		pointer-events: none;
		opacity: 0;
		transition: opacity 300ms ease 100ms;
	}

	.page-loader.is-active {
		opacity: 1;
		transition: none;
	}

	.page-loader.is-done {
		opacity: 0;
		transition: opacity 300ms ease 100ms;
	}

	.page-loader__bar {
		height: 100%;
		background: var(--color-brand);
		box-shadow: 0 0 8px var(--color-brand);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 250ms ease-out;
	}

	@media (prefers-reduced-motion: reduce) {
		.page-loader__bar {
			transition: none;
		}
	}
</style>
